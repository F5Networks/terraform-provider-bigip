// TestResourceBigipWidgetSchema checks the resource's schema shape without
// needing any BIG-IP connection: required/computed fields, and that the CRUD
// functions are wired up.
func TestResourceBigipWidgetSchema(t *testing.T) {
	r := resourceBigipWidget() // TODO: replace with the real constructor, e.g. resourceBigipLtmPool()

	if r.Schema == nil {
		t.Fatal("Expected schema to be defined")
	}
	if r.CreateContext == nil {
		t.Fatal("Expected CreateContext to be defined")
	}

	// TODO: assert on the fields that matter for this resource, e.g.:
	nameSchema, ok := r.Schema["name"]
	if !ok {
		t.Fatal("Expected field 'name' to exist in schema")
	}
	if !nameSchema.Required {
		t.Error("Expected field 'name' to be required")
	}
}

// ---------------------------------------------------------------------
// 2. Standard "invalidkey" schema-rejection test
// ---------------------------------------------------------------------

func testBigipWidgetInvalid(resourceName string) string {
	return fmt.Sprintf(`
resource "bigip_widget" "test" {
  name       = "%s"
  invalidkey = "foo"
}
`, resourceName)
}

func TestAccBigipWidgetInvalid(t *testing.T) {
	resourceName := "/Common/test-widget"
	resource.Test(t, resource.TestCase{
		IsUnitTest: true,
		Providers:  testAccProviders,
		Steps: []resource.TestStep{
			{
				Config:      testBigipWidgetInvalid(resourceName),
				ExpectError: ExpectUnexpectedArgumentError,
			},
		},
	})
}

